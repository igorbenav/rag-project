# ---- Database (matches docker-compose service names) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=ragdb

# ---- Application ----
ENVIRONMENT=development
DEBUG=true
CREATE_TABLES_ON_STARTUP=true

# ---- API ----
CORS_ENABLED=true
CORS_ORIGINS=*

# ---- Security ----
# API_KEY_REQUIRED=true
# API_KEY_BOOTSTRAP=true
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_BURST=20

# ---- Mistral ----
# The key printed in the brief is dead (401). Get your own at console.mistral.ai
MISTRAL_API_KEY=
# MISTRAL_EMBED_MODEL=mistral-embed
# MISTRAL_CHAT_MODEL=mistral-small-latest
# MISTRAL_GENERATION_MODEL=mistral-medium-latest
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=64

# EVIDENCE_CHECK_ENABLED=true
# RETRIEVAL_MIN_SIMILARITY=0.70

# ---- Background worker ----
TASKIQ_REDIS_URL=redis://redis:6379/0
# TASKIQ_QUEUE_NAME=ingestion
# TASKIQ_MAX_RETRIES=2

# ---- Logging ----
# LOG_LEVEL=INFO
