# ---- Database (matches docker-compose service names) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=ragdb

# ---- Application ----
ENVIRONMENT=development
DEBUG=true
CREATE_TABLES_ON_STARTUP=true

# ---- API ----
CORS_ENABLED=true
CORS_ORIGINS=*

# ---- Logging ----
# LOG_LEVEL=INFO
